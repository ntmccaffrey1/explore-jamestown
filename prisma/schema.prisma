generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  name  String?
  email String? @unique
  image String?
  role  Role    @default(USER)

  emailVerified DateTime?

  accounts  Account[]
  sessions  Session[]
  favorites Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}

model Favorite {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  placeId String? @db.ObjectId
  eventId String? @db.ObjectId

  user  User   @relation(fields: [userId], references: [id])
  place Place? @relation(fields: [placeId], references: [id])
  event Event? @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([placeId])
  @@index([eventId])
}

model Place {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  recid Int?    @unique // optional but strongly recommended
  slug  String? @unique

  type        String
  name        String
  address     String?
  phone       String?
  email       String?
  website     String?
  menu        String?
  socials     Json?
  image       String?
  favorites   Favorite[]
  images      String[]
  description String?
  amenities   String[]
  city        String?
  url         String?
  lat         Float?
  lng         Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([city])
  @@index([name])
}

model Event {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  recid       Int?      @unique
  title       String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  url         String?
  website     String?
  price       String?
  images      String[]
  venue       String?
  rawCategory String?
  category    String?
  approved    Boolean   @default(true)
  sources     String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  favorites Favorite[]
}

enum Role {
  USER
  ADMIN
}
